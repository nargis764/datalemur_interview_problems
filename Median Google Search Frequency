WITH cte1 AS (
SELECT searches,
num_users,
SUM(num_users) OVER(ORDER BY searches) AS result
FROM search_frequency
),
cte2 AS (
SELECT *
FROM cte1
WHERE result IN (SELECT (max(result)/2)+1 FROM cte1
                   UNION 
                   SELECT max(result)/2 
                   FROM cte1)
)
SELECT ROUND(1.0*SUM(searches)/2, 1) AS median_seraches FROM cte2
